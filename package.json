{
  "name": "requirement-sheet-generator",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "test": "tsx src/lib/requirements.test.ts",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "render:sample": "tsx scripts/render-sample.tsx",
    "scrape:badges": "tsx scripts/scrape-badges.ts",
    "check:badges": "tsx scripts/check-badges.ts",
    "simplify:prep": "tsx scripts/simplify-prep.ts",
    "simplify:apply": "tsx scripts/simplify-apply.ts",
    "render:badges": "tsx scripts/render-badges.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/tanstack-react-start": "^1.4.26",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "^1.168.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260702-173353-03122331",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "requirement-tree": "github:Quincy-Friends-of-Scouting/requirement-tree",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "requirement-tree"
    ]
  }
